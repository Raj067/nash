RewriteEngine On

# File Upload Configuration - Increased limits for large file handling
php_value upload_max_filesize 500M
php_value post_max_size 500M
php_value max_execution_time 3600
php_value max_input_time 3600
php_value memory_limit 1024M
php_value max_file_uploads 100
php_value max_input_vars 10000
php_value max_input_nesting_level 128

# Remove /public/ from URLs if accessed directly
RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
RewriteRule ^ /%1 [R=301,L]

# Rewrite everything to public folder
RewriteRule ^(.*)$ public/$1 [L]

# Security: Hide sensitive files and directories
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|artisan)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Hide Laravel directories from direct access
<IfModule mod_alias.c>
    RedirectMatch 404 /^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$
</IfModule>

# Disable Directory Listing
Options -Indexes

# Cache static assets
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|js|css|json|xml|txt|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

